{
  "name": "pi-llm",
  "version": "0.1.0",
  "description": "Personal-assistant backend: a low-latency chat agent defers write work to a background worker agent, running on local LLMs with Google Calendar and Tasks integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txchin0/pi-llm.git"
  },
  "keywords": [
    "llm",
    "agents",
    "personal-assistant",
    "llama.cpp",
    "fastify",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs watch src/bootstrap/start.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "trace:prettify": "node ./node_modules/tsx/dist/cli.mjs scripts/prettify-worker-trace.mts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@fastify/cors": "^11.4.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.3",
    "googleapis": "^189.0.0",
    "luxon": "^3.7.2",
    "pino": "^10.4.0",
    "typebox": "^1.4.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}

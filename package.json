{
  "name": "pi-llm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs watch src/bootstrap/start.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "trace:prettify": "node ./node_modules/tsx/dist/cli.mjs scripts/prettify-worker-trace.mts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "google-auth-library": "^10.7.0",
    "googleapis": "^173.0.0",
    "luxon": "^3.7.2",
    "pino": "^10.3.1",
    "typebox": "^1.1.38",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.0"
  }
}

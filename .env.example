# Server (see src/config/env.ts for supported variables)
PORT=3000
# IANA timezone for user message time context (default: Australia/Sydney)
# TIMEZONE=Australia/Sydney
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true

# Surface agent LLM (llama.cpp OpenAI-compatible server)
SURFACE_LLM_BASE_URL=http://127.0.0.1:8080/v1
SURFACE_LLM_MODEL_ID=gemma-4-12b-qat
SURFACE_LLM_API_KEY=local
SURFACE_LLM_PROVIDER=llamacpp
SURFACE_LLM_CONTEXT_WINDOW=8192
SURFACE_LLM_MAX_TOKENS=2048
SURFACE_THINKING_ENABLED=false
SURFACE_THINKING_LEVEL=low

# Worker agent LLM (llama.cpp OpenAI-compatible server)
WORKER_ENABLED=true
WORKER_LLM_BASE_URL=http://127.0.0.1:8080/v1
WORKER_LLM_MODEL_ID=gemma-4-12b-qat
WORKER_LLM_API_KEY=local
WORKER_LLM_PROVIDER=llamacpp
WORKER_LLM_CONTEXT_WINDOW=8192
WORKER_LLM_MAX_TOKENS=2048
WORKER_THINKING_ENABLED=true
WORKER_THINKING_LEVEL=high
WORKER_RUN_TRACE=true

#Shared data root for user memory workspaces
DATA_ROOT=./data


# Google OAuth (optional; enables Google Calendar and future Google integrations)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-host/v1/oauth/google/callback
